class_name Stages extends RefCounted

## Stage definitions. Every stage uses the same rules (smash props of an
## unlocked tier, each tier makes the truck bigger); stages differ in room,
## layout, time limit, tier thresholds and star goals.
##
## layout:  furniture  {p, t (tier), h (height), s (points), x, z, rot, r (keep-out), sc (fixed scale)}
## clutter: scattered  {p | toy, t, h, s, c (count), col (tint for food models)}

const FUR: = "res://assets/models/furniture/"
const FOOD: = "res://assets/models/food/"

## Star goals as a fraction of the stage's total prop points; 1.0 = smash
## everything (which also ends the run early with a time bonus).
const STAR_FRACTIONS: = [0.25, 0.6, 1.0]

## Selected stage (survives scene reloads).
static var current: int = 0

static func get_stage(i: int = -1) -> Dictionary:
	return STAGES[current if i < 0 else i]

static func count() -> int:
	return STAGES.size()

